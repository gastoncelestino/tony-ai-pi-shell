HOME=/home/tony/
TONY_LLAMASWAP_URL=http://localhost:8080
TONY_LLAMASWAP_BIN=/usr/local/bin/llama-swap
TONY_LLAMASWAP_CONFIG=/home/tony/tony-ai-pi-min/config.yaml
# --- Estado de runtime: todo vive FUERA del proyecto ---
# El proyecto guarda código y configuración; las corridas dejan datos en
# TONY_AI_HOME (/home/tony/.tony-ai). Ahí viven la memoria local, el storage
# de Qdrant y los marcadores que Qdrant crea en su directorio de trabajo
# (.qdrant-initialized y snapshots/).
TONY_AI_HOME=/home/tony/.tony-ai
TONY_MEMORY_DIR=/home/tony/.tony-ai/local-memory
TONY_QDRANT_STORAGE=/home/tony/.tony-ai/local-memory/qdrant
TONY_PROJECT_MAP=1
TONY_CODE_INDEX=1
TONY_LLAMASWAP_LOG=/home/tony/.tony-ai/logs-pi
TONY_UNLOAD_ON_EXIT=1  
PI_WARM=1            
PI_WARM_TIMEOUT=120
PI_BIN=pi

# Qdrant: capa semántica de tony-mem (instancia propia, puerto 6334).
# El server lee TONY_QDRANT_URL; si no está, degrada a SQLite/FTS5.
# TONY_QDRANT_STORAGE tiene que coincidir con el storage_path de
# scripts/qdrant.yaml: scripts/pi.sh lo verifica antes de levantar Qdrant.
TONY_QDRANT_URL=http://127.0.0.1:6334
TONY_QDRANT_BIN=/usr/local/bin/qdrant

# tony-mem: base SQLite por proyecto. El nombre del archivo define el
# proyecto y, con él, las colecciones de Qdrant (mem_tony-ai-pi-min).
# El server es una copia vendorizada en el proyecto (local-memory/server.py);
# los datos viven en TONY_MEMORY_DIR.
LOCAL_MEMORY_DB=/home/tony/.tony-ai/local-memory/tony-ai-pi-min.db
LOCAL_MEMORY_TEST_DB=/home/tony/.tony-ai/local-memory/tony-ai-pi-min-test.db
TONY_MEM_SERVER=/home/tony/tony-ai-pi-min/local-memory/server.py

# Modelo de embeddings para decisiones/recipes (semantic layer).
JUDGMENT_EMBED_MODEL=nomic-embed-text

# Umbral de cosine para el recall semántico. El default de tony-mem (0.5) es
# demasiado bajo con nomic-embed-text: medido, texto no relacionado llega a
# 0.64 y texto relacionado baja a 0.685. Con 0.65 la separación es limpia
# (7/7 aciertos, 0 falsos positivos sobre 16 consultas no relacionadas).
TONY_RECALL_SCORE_THRESHOLD=0.65

# Kill switch de la memoria local: TONY_MEMORY=0 apaga recall y guardado.
TONY_MEMORY=1

# Ledger durable de decisiones del Kernel: TONY_LEDGER=0 lo apaga.
TONY_LEDGER=1

# --- Autorización de herramientas (la decide el Kernel, no el modelo) ---
# Herramientas que el WORKER puede usar. "*" habilita cualquiera.
TONY_ALLOWED_TOOLS=read,bash,task_complete
# Herramientas que necesitan una decisión humana: en la TUI se pregunta, en
# cualquier otro modo se niegan (no hay quien conteste).
TONY_ASK_TOOLS=write,edit
# Herramientas prohibidas: ganan sobre la lista de habilitadas.
TONY_DENIED_TOOLS=
# Presupuestos del turno: llamadas de herramienta y duración.
# El límite efectivo de llamadas es max(TONY_MAX_TOOL_CALLS, tareas ×
# TONY_MAX_TOOL_CALLS_PER_TASK): las tareas atómicas consumen más llamadas
# dentro del mismo turno y un límite fijo lo agotaría a mitad de camino.
TONY_MAX_TOOL_CALLS=40
TONY_MAX_TOOL_CALLS_PER_TASK=8
TONY_MAX_TURN_SECONDS=1200
# Una herramienta anotada como destructiva se pregunta aunque esté habilitada.
TONY_CONFIRM_DESTRUCTIVE=1
# Alcance: por defecto, el proyecto, el runtime local y el temporal.
# TONY_TOOL_SCOPE=/home/tony/tony-ai-pi-min,/home/tony/.tony-ai,/tmp