{
  "name": "tony-ai-pi-shell",
  "version": "0.0.7",
  "private": true,
  "type": "module",
  "imports": {
    "#kernel/*": "./kernel/*"
  },
  "pi": {
    "extensions": ["./extensions"],
    "skills": ["./skills"],
    "prompts": ["./prompts"],
    "themes": ["./themes"]
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "1.4.0"
  },
  "scripts": {
    "pi": "node ./node_modules/@earendil-works/pi-coding-agent/dist/bundle/cli.js",
    "pi:version": "node ./node_modules/@earendil-works/pi-coding-agent/dist/bundle/cli.js --version",
    "test:kernel": "node --experimental-transform-types --test tests/*.test.mjs"
  },
  "overrides": {
    "undici": "8.12.2"
  }
}
